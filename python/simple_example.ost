OpenSTF 4 2
title = 簡単なサンプル - 平行平板コンデンサ
# X, Y, Z方向のメッシュ定義（-10から10まで、各20分割）
xmesh = -10 20 10
ymesh = -10 20 10
zmesh = -10 20 10
# 電圧定義（2個以上必要）
volt = 1.0 上部電極
volt = 0.0 下部電極
# 比誘電率定義
epsr = 1.0 空気
# 物体形状定義
# 上部電極（電圧番号1、直方体）
geometry = 1 1 1 -8 8 -8 8 5 5
# 下部電極（電圧番号2、直方体）
geometry = 1 2 1 -8 8 -8 8 -5 -5
# ソルバー設定（omega, 最大反復回数, 表示間隔, 収束判定値）
solver = 1.95 1000 50 1e-5
# プロット設定
plotiter = 1
plot1d = V Z 0 0
1dlog = 1
plot2d = V X 0
plot2d = E Z 0
2dcontour = 0
2dobject = 1 1
2dlog = 1
end
